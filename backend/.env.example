NODE_ENV=development
PORT=4011
DATABASE_URL=postgresql://pravnyaadmin_app:CHANGE_ME@localhost:5432/Pravnya?schema=admin
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:5176

# Optional -- powers the AI goal-skill suggestion feature (backend/src/modules/ai/). Without
# either set, the feature degrades gracefully and returns "no suggestion available".
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# "Call Pravnya" (hands-free home sessions) uses Gemini's Live API. Defaults shown.
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_API_VERSION=v1beta

# Uploaded pictures (visual schedule photos). "local" keeps them in LOCAL_STORAGE_DIR (development);
# "s3" uses any S3-compatible store -- for Cloudflare R2 set S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# and S3_REGION=auto. The bucket stays private: the API serves each picture through a signed link.
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./storage
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Schedule reminders in the parent app (Web Push). Make a pair with `npx web-push generate-vapid-keys`.
# Without them, reminders are off and the app doesn't offer them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
