# Copy to backend/.env.test for local test runs (`npm test`). The database name MUST contain
# "test" -- integration tests empty every table between tests and refuse to run otherwise.
NODE_ENV=test
DATABASE_URL=postgresql://pravnyaadmin_app:CHANGE_ME@localhost:5432/pravnya_test?schema=admin
JWT_SECRET=local-test-secret-at-least-32-characters-long
EMAIL_PROVIDER=memory
BCRYPT_SALT_ROUNDS=4
# Fixed id for the retail tenant -- tests create this tenant with makeRetailTenant().
RETAIL_TENANT_ID=00000000-0000-4000-8000-000000000001
