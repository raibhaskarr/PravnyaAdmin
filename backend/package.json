{
  "name": "pravnyaadmin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.3.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@pravnix/ai-core": "file:vendor/pravnix/pravnix-ai-core-0.1.0-preview.1.tgz",
    "@pravnix/ai-node": "file:vendor/pravnix/pravnix-ai-node-0.1.0-preview.1.tgz",
    "@pravnix/ai-abstractions": "file:vendor/pravnix/pravnix-ai-abstractions-0.1.0-preview.1.tgz",
    "@pravnix/ai-structured-output": "file:vendor/pravnix/pravnix-ai-structured-output-0.1.0-preview.1.tgz",
    "@pravnix/ai-provider-support": "file:vendor/pravnix/pravnix-ai-provider-support-0.1.0-preview.1.tgz",
    "@pravnix/ai-observability": "file:vendor/pravnix/pravnix-ai-observability-0.1.0-preview.1.tgz",
    "@pravnix/ai-provider-fake": "file:vendor/pravnix/pravnix-ai-provider-fake-0.1.0-preview.1.tgz",
    "@pravnix/ai-orchestration": "file:vendor/pravnix/pravnix-ai-orchestration-0.1.0-preview.1.tgz",
    "@pravnix/ai-provider-anthropic": "file:vendor/pravnix/pravnix-ai-provider-anthropic-0.1.0-preview.1.tgz",
    "@pravnix/ai-provider-gemini": "file:vendor/pravnix/pravnix-ai-provider-gemini-0.1.0-preview.1.tgz",
    "@pravnix/ai-provider-openai": "file:vendor/pravnix/pravnix-ai-provider-openai-0.1.0-preview.1.tgz",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
