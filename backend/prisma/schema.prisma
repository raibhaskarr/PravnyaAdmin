generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// DATABASE_URL includes `?schema=admin` -- this backend's migrations only ever
// touch the `admin` schema inside the shared Pravnya database, kept separate
// from the Pravnya client backend's `public` schema/migration history.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  TENANT_ADMIN
  THERAPIST
  VIEWER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SkillSource {
  PROD
  FRAMEWORK
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  DISCONTINUED
}

enum Modality {
  VERBAL
  MANUAL_SIGN
  AAC
  WRITTEN
  GESTURAL
}

enum KidStatus {
  ACTIVE
  ARCHIVED
}

/// Single login table for every user in the system. SUPERADMIN rows have tenantId = null; every
/// other role is scoped to exactly one tenant. A therapist working across multiple tenants is a
/// known future case, not modeled here.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole
  tenantId     String?   @db.Uuid
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  therapist    Therapist?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model Tenant {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  slug       String        @unique
  status     TenantStatus  @default(ACTIVE)
  users      User[]
  disciplines TenantDiscipline[]
  therapists Therapist[]
  kids       Kid[]
  goals      Goal[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model CanonicalDomain {
  id        String          @id @default(uuid()) @db.Uuid
  key       String          @unique
  name      String
  sortOrder Int             @default(0)
  skills    CanonicalSkill[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CanonicalDiscipline {
  id                String           @id @default(uuid()) @db.Uuid
  key               String           @unique
  name              String
  defaultForSkills  CanonicalSkill[] @relation("DefaultDiscipline")
  tenants           TenantDiscipline[]
  goals             Goal[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model CanonicalSkill {
  id                   String              @id @default(uuid()) @db.Uuid
  domainId             String              @db.Uuid
  domain               CanonicalDomain     @relation(fields: [domainId], references: [id], onDelete: Restrict)
  key                  String              @unique
  name                 String
  description          String?
  defaultDisciplineId  String?             @db.Uuid
  defaultDiscipline    CanonicalDiscipline? @relation("DefaultDiscipline", fields: [defaultDisciplineId], references: [id], onDelete: SetNull)
  supportsItems        Boolean             @default(false)
  /// Suggested response modalities for this skill (e.g. a receptive skill's natural response is
  /// pointing/selecting, not speaking) -- a default like defaultDisciplineId, not a hard lock.
  /// Empty for skills where "modality" doesn't apply at all (motor, sensory, behavior, adaptive).
  supportedModalities  Modality[]          @default([])
  sourceTag            SkillSource         @default(FRAMEWORK)
  items                CanonicalSkillItem[]
  goals                Goal[]
  pocGoalTags          PocGoalTag[]
  pocLogEvidence       PocLogEvidence[]
  createdAt            DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([domainId])
}

model CanonicalSkillItem {
  id            String         @id @default(uuid()) @db.Uuid
  skillId       String         @db.Uuid
  skill         CanonicalSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  key           String
  displayName   String
  semanticGroup String         @default("OTHER")
  aliases       Json?
  goalItems     GoalItem[]
  pocLogEvidence PocLogEvidence[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([skillId, key])
  @@index([skillId])
}

model TenantDiscipline {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  disciplineId String              @db.Uuid
  discipline   CanonicalDiscipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())

  @@unique([tenantId, disciplineId])
  @@index([tenantId])
}

model Therapist {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  disciplineIds String[] @default([])
  kids          KidTherapist[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model Kid {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  dob        DateTime?
  status     KidStatus   @default(ACTIVE)
  therapists KidTherapist[]
  goals      Goal[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([tenantId])
}

model KidTherapist {
  id          String    @id @default(uuid()) @db.Uuid
  kidId       String    @db.Uuid
  kid         Kid       @relation(fields: [kidId], references: [id], onDelete: Cascade)
  therapistId String    @db.Uuid
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([kidId, therapistId])
  @@index([therapistId])
}

model Goal {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kidId            String              @db.Uuid
  kid              Kid                 @relation(fields: [kidId], references: [id], onDelete: Cascade)
  canonicalSkillId String              @db.Uuid
  canonicalSkill   CanonicalSkill      @relation(fields: [canonicalSkillId], references: [id], onDelete: Restrict)
  disciplineId     String              @db.Uuid
  discipline       CanonicalDiscipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  modality         Modality
  title            String
  status           GoalStatus          @default(ACTIVE)
  notes            String?
  items            GoalItem[]
  createdById      String?             @db.Uuid
  updatedById      String?             @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tenantId, kidId])
  @@index([canonicalSkillId])
}

/// The concrete, per-kid content a goal is actually practiced with -- e.g. which WH-question
/// type(s) and/or the literal question text ("Where do you live?"). Either field can carry the
/// row (enforced at the service layer, not the DB): canonicalSkillItemId for shared vocabulary
/// (an animal, a phoneme, a WH-question type), customText for content that's inherently personal
/// to this kid and was never meant to live in the shared canonical bank.
model GoalItem {
  id                   String              @id @default(uuid()) @db.Uuid
  goalId               String              @db.Uuid
  goal                 Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  canonicalSkillItemId String?             @db.Uuid
  canonicalSkillItem   CanonicalSkillItem? @relation(fields: [canonicalSkillItemId], references: [id], onDelete: SetNull)
  customText           String?
  createdAt            DateTime            @default(now())

  @@index([goalId])
}

enum PocEvidenceOutcome {
  CORRECT
  INCORRECT
  PARTIAL
  ATTEMPTED
  NOT_OBSERVED
  UNKNOWN
}

enum PocSupportLevel {
  INDEPENDENT
  VISUAL_PROMPT
  VERBAL_PROMPT
  GESTURAL_PROMPT
  PHYSICAL_PROMPT
  PARTIAL_ASSISTANCE
  FULL_ASSISTANCE
  UNKNOWN
}

enum PocGoalTagStatus {
  TAGGED
  NO_MATCH
  ERROR
}

/// The response modality the child actually used in this piece of evidence, as judged by the AI
/// from the log text (e.g. pointed to an AAC device vs. said the word aloud) -- not the same thing
/// as the Canonical Skill's own `supportedModalities`, which is what the skill is designed to
/// allow, not what happened in any one real instance.
enum PocModality {
  VERBAL
  MANUAL_SIGN
  AAC
  WRITTEN
  GESTURAL
  UNKNOWN
  NOT_APPLICABLE
}

/// What a skill/target is actually measured by, clinically -- a discrete right/wrong trial is only
/// one shape among several (duration, frequency, prompt level, yes/no, ...). Declared once per
/// skill in the extraction pipeline's own classification (not on CanonicalSkill itself -- this POC
/// never writes to the real production taxonomy), null means "not yet classified, falls back to
/// outcome/supportLevel" so unclassified skills are unaffected.
enum PocMeasurementType {
  TRIALS
  FREQUENCY
  DURATION
  PERCENTAGE
  PROMPT_LEVEL
  YES_NO
  RATING
  FREE_OBSERVATION
}

enum PocReviewFlagKind {
  /// The two providers tagged the same real goal (by sourceGoalId) to two different skills.
  GOAL_DISAGREEMENT
  /// A skill has log evidence but no goal (from either provider) was ever tagged to it for this
  /// child -- may mean a goal exists but was missed, or the evidence is genuinely incidental.
  EVIDENCE_WITHOUT_GOAL
}

/// A human's resolution of a review flag -- the flags themselves (disagreements, evidence without a
/// goal) are computed live from PocGoalTag/PocLogEvidence on every request, never stored; this table
/// persists only what a person decided once they looked at one. This is the judgment layer the
/// future "promotion" path (turning a reviewed POC mapping into a real Goal/GoalItem) depends on --
/// plain UUID columns throughout, not Prisma relations, matching PocReviewChild.sourceChildId's own
/// precedent for referencing something outside this table's own small graph.
model PocReviewDecision {
  id               String             @id @default(uuid()) @db.Uuid
  childId          String             @db.Uuid
  child            PocReviewChild     @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind             PocReviewFlagKind
  /// Set for GOAL_DISAGREEMENT -- the real IEPGoal.id both providers tagged (PocGoalTag.sourceGoalId).
  sourceGoalId     String?            @db.Uuid
  /// Set for EVIDENCE_WITHOUT_GOAL -- the skill that has evidence but no goal tag.
  canonicalSkillId String?            @db.Uuid
  /// The skill a reviewer decided is actually correct. Null for an EVIDENCE_WITHOUT_GOAL
  /// acknowledgement (there's no competing prediction to pick between, just "seen, this is fine").
  resolvedSkillId  String?            @db.Uuid
  /// Set when a reviewer links an EVIDENCE_WITHOUT_GOAL skill to a real goal (PocGoalTag.sourceGoalId)
  /// -- usually confirming a PocEvidenceGoalSuggestion, but not required to match one.
  resolvedSourceGoalId String?        @db.Uuid
  /// 'gemini' | 'claude' | 'manual' (disagreement resolutions) or 'acknowledged' / 'linked_goal'
  /// (evidence-without-goal). Free string, not an enum -- mirrors modelProvider elsewhere here.
  resolvedSource   String?
  note             String?
  decidedById      String?            @db.Uuid
  decidedAt        DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([childId, kind])
}

/// A reverse-direction AI suggestion: for a skill that has evidence but no tagged goal, which of
/// this child's real goals (if any) does it most plausibly belong under -- a looser, best-effort
/// search across the whole goal list, unlike the original per-goal tagging pass which requires one
/// specific goal to pick one specific skill. Always a suggestion for a human to confirm or dismiss
/// via PocReviewDecision, never auto-applied. One row per (childId, canonicalSkillId) -- replaced
/// wholesale each time this pass re-runs, same replace-on-import pattern as PocGoalTag/PocLogEvidence.
model PocEvidenceGoalSuggestion {
  id                String         @id @default(uuid()) @db.Uuid
  childId           String         @db.Uuid
  child             PocReviewChild @relation(fields: [childId], references: [id], onDelete: Cascade)
  canonicalSkillId  String         @db.Uuid
  /// Null means the AI found no plausible goal either -- a real, useful finding (the evidence is
  /// most likely genuinely incidental), not a missing row.
  suggestedGoalId   String?        @db.Uuid
  /// Snapshot of the goal's title at suggestion time -- no live Goal table to join against here.
  suggestedGoalTitle String?
  confidence        Float?
  rationale         String?
  modelProvider     String
  modelName         String
  createdAt         DateTime       @default(now())

  @@unique([childId, canonicalSkillId])
}

/// Not tenant-scoped -- this is a superadmin-only review surface for the AI goal/log tagging POC
/// (see PranTrackingSystem's docs/l12-growth-intelligence-*.md), covering two real children who
/// aren't PravnyaAdmin Kids yet. Exists to let a human judge tagging quality against the real
/// Canonical Skill taxonomy before any real child-data import happens. A label (first name), not a
/// Kid record -- sourceChildId is PranTrackingSystem's own child id, kept only for traceability.
model PocReviewChild {
  id                String                       @id @default(uuid()) @db.Uuid
  label             String
  sourceChildId     String                       @unique @db.Uuid
  goalTags          PocGoalTag[]
  logEvidence       PocLogEvidence[]
  reviewDecisions   PocReviewDecision[]
  goalSuggestions   PocEvidenceGoalSuggestion[]
  createdAt         DateTime                     @default(now())
}

/// One row per source goal (IEPGoal.title, deliberately -- never the encrypted description field).
/// predictedSkillId is nullable because a goal can legitimately have no reasonable taxonomy match
/// (status = NO_MATCH) -- that's a real, useful finding, not an error.
model PocGoalTag {
  id                 String             @id @default(uuid()) @db.Uuid
  childId            String             @db.Uuid
  child              PocReviewChild     @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// The real IEPGoal.id this tag was produced from. Nullable only because rows pushed before
  /// 2026-10-04 don't carry it -- durable (unlike this row's own id) across re-imports, since a
  /// provider re-push deletes and recreates all of that provider's PocGoalTag rows wholesale. This
  /// is what lets PocReviewDecision survive a re-run: it's keyed to the real goal, not to a row that
  /// gets thrown away on every pipeline iteration.
  sourceGoalId       String?            @db.Uuid
  goalTitle          String
  /// The goal's own domain/category exactly as entered by the therapist (IEPGoal.domainName /
  /// .category) -- never encrypted, kept for comparison against the AI-predicted skill's domain.
  originalDomainName String?
  originalCategory   String?
  /// Therapy centre(s) this goal is linked to in PranTrackingSystem (IEPGoalCenterEnrollment ->
  /// CenterEnrollment.centerName), comma-joined if more than one. Null means home-only/unlinked.
  centreName         String?
  predictedSkillId   String?            @db.Uuid
  predictedSkill   CanonicalSkill?    @relation(fields: [predictedSkillId], references: [id], onDelete: SetNull)
  confidence       Float?
  rationale        String?
  status           PocGoalTagStatus
  modelProvider    String
  modelName        String
  createdAt        DateTime           @default(now())

  @@index([childId])
  @@index([sourceGoalId])
}

/// One row per extracted piece of evidence from a daily log -- a single log can yield several.
/// Deliberately has no excerpt/source-text field: this surfaces only derived, structured output,
/// never the underlying clinical free text, which stays in PranTrackingSystem's encrypted storage.
model PocLogEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  childId          String             @db.Uuid
  child            PocReviewChild     @relation(fields: [childId], references: [id], onDelete: Cascade)
  logDate          DateTime?
  /// The therapy centre this daily log's CenterEnrollment pointed to in PranTrackingSystem. Null
  /// for most logs -- the source field is rarely set at log-creation time (home logs especially).
  centreName       String?
  predictedSkillId String?            @db.Uuid
  predictedSkill   CanonicalSkill?    @relation(fields: [predictedSkillId], references: [id], onDelete: SetNull)
  itemHint         String?
  /// The real CanonicalSkillItem itemHint was matched to, if any -- an AI-based second pass
  /// (constrained to just that skill's own item candidates), not the same call that picked the
  /// skill above. itemMatchMethod records how: ai | ai_no_match | no_hint | not_applicable.
  predictedItemId  String?            @db.Uuid
  predictedItem    CanonicalSkillItem? @relation(fields: [predictedItemId], references: [id], onDelete: SetNull)
  itemMatchScore   Float?
  itemMatchMethod  String?
  outcome          PocEvidenceOutcome
  supportLevel     PocSupportLevel
  modality         PocModality        @default(UNKNOWN)
  /// Only set for the handful of skills hand-classified for this proof-of-concept (see
  /// tools/l12-poc-tagging/scripts/skill-measurement-types.ts) -- most evidence has this null and
  /// is unaffected. When set, one of the value fields below is also set, matching the type:
  /// TRIALS -> numerator/denominator, FREQUENCY -> numericValue (count) + unitLabel, DURATION ->
  /// numericValue (seconds) + unitLabel, PERCENTAGE -> numericValue (0-100), PROMPT_LEVEL -> reuse
  /// supportLevel above (no separate field), YES_NO -> booleanValue, RATING -> numericValue,
  /// FREE_OBSERVATION -> textValue.
  measurementType        PocMeasurementType?
  measurementNumerator   Int?
  measurementDenominator Int?
  measurementValue       Float?
  measurementUnit        String?
  measurementBoolean     Boolean?
  measurementText        String?
  confidence       Float?
  modelProvider    String
  modelName        String
  createdAt        DateTime           @default(now())

  @@index([childId])
  @@index([predictedSkillId])
}
